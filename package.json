{
  "name": "yuna-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first desktop notebook built with Tauri, Rust, SQLite, React, and TypeScript.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4320 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4320",
    "tauri": "tauri",
    "test": "tsx --test tests/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm test && npm run build && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
